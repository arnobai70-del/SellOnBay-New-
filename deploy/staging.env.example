# SellOnBay 2.0 STAGING environment (template). Copy into the staging host's secret settings; never commit real values, never paste them
# into chat, issues or logs. The app refuses to start (503 on every request) if SITE_STAGE=staging and any check in lib/stage.ts fails.
# Staging Supabase project: occketfmjwciilzuddkv ("SellOnBay New"). The production project must never appear here.

# --- staging switch and protection (lib/stage.ts) ---
SITE_STAGE=staging
# "user:password", password at least 12 characters; every page and API asks for it (HTTP Basic), except /api/health and /api/cron/*
STAGING_BASIC_AUTH=

# --- Supabase: the staging project only ---
NEXT_PUBLIC_SUPABASE_URL=https://occketfmjwciilzuddkv.supabase.co
# Dashboard > Project settings > API keys of occketfmjwciilzuddkv (publishable / anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same page, secret / service role. Server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- the staging address (never sellonbay.com) ---
NEXT_PUBLIC_SITE_URL=https://<staging-host>

# --- no real outside services ---
NEXT_PUBLIC_GA_ID=off
NEXT_PUBLIC_TAWK_PROPERTY_ID=off
# PayPal, email provider, registrar, GA4 Data API and ad keys: leave unset on staging
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=
AD_TOKEN_KEY=
FIRST_PARTY_COUNTRY_TRUSTED=
# Never set on staging or production: it makes the made-up example listings buyable
EXAMPLE_ORDERS=

# --- staging-only secrets: new random values, different from production (e.g. `openssl rand -hex 32`) ---
DELIVERY_SECRET=
PAYMENT_WEBHOOK_SECRET=
CRON_SECRET=
GUARD_SALT=
ANALYTICS_SALT=

# --- optional ---
# ERROR_WEBHOOK_URL=          a staging-only alert channel
# RELEASE_DELAY_MINUTES=0     release delays stay off unless a test needs them
